# Shannon testnet
RPC_URL=https://api.infra.testnet.somnia.network
# AegisCover marketplace core (registry + LP vault; deployed 2026-05-25)
COVER_ADDRESS=0x47824E585F7eCd4dD6574800625570ba9642FaB2
# Watcher signer — needed for live requestCheck AND the risk keeper.
# NOTE: requestRiskAssessment is onlyOwner, so this MUST be the cover owner/deployer key.
# Omit for --dry-run.
PRIVATE_KEY=
# Targets to monitor, index-aligned with TARGETS_KIND below. Marketplace phase: two live targets —
# DrainableVault (Exploit/reentrancy, tvl-mode) + MockStable (Depeg, price-mode). Re-arm fresh per
# recording (deploy-drainvault.sh / deploy-mockstable.sh — settled targets are sticky) and paste here.
# Below = the 2026-05-25 rehearsal run (now settled).
TARGETS=0x4B2f15360F2CA318DaE456692300002672DC93B6,0x1C1593F4BB196010Cf97Dcfc27fD5D4E6bc7bB80
# Trigger a check when TVL drops at least this many bps from the in-window peak (3000 = 30%)
DROP_THRESHOLD_BPS=3000
# Per-target value source, index-aligned with TARGETS. Omit (or "tvl") = watch native balance for
# a drain. "price" = watch the target's price() against a peg and fire on a DEPEG (e.g. MockStable).
# Example for two targets (DemoVault drain + MockStable depeg):
#   TARGETS=0xDemoVault,0xMockStable
#   TARGETS_KIND=tvl,price
#   PEG_WEI=,1000000000000000000      # index-aligned: tvl entry empty, price peg = 1e18
#   DEPEG_BAND_BPS=,200               # fire when price <= peg*(1 - 200/10000) = 2% below peg
TARGETS_KIND=tvl,price
PEG_WEI=,1000000000000000000
DEPEG_BAND_BPS=,200
POLL_INTERVAL_MS=5000
WINDOW_SECONDS=120
COOLDOWN_MS=60000
# Periodic AI risk-keeper — the AUTONOMOUS re-pricing leg: when the cached risk score for a
# target is older than this interval, the watcher fires requestRiskAssessment itself so premiums
# track current risk with no human. The frontend buy-quote reads this cache. Requires PRIVATE_KEY
# (owner) and spends ~0.37 STT of the ORACLE deposit per run. Proven live (score refreshed 75→85).
# 21600000 = every 6h (recommended). Set 0 to disable (e.g. to conserve oracle STT between demos).
RISK_ASSESS_INTERVAL_MS=21600000
# In-process throttle so the keeper doesn't re-fire while a verdict is pending (~1-2 min).
RISK_ASSESS_MIN_GAP_MS=300000
